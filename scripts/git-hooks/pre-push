#!/usr/bin/env bash
#
# Pre-push gate: the build pipeline's format and lint steps, before anything leaves this
# clone.
#
# A full pipeline run costs ~20 minutes locally and ~27 on CI, and two of the cheapest
# ways to waste one are a formatting slip and a clippy warning — both caught here in
# about a minute. This hook runs those two steps and nothing else; the full pipeline
# stays the gate before a merge (POLICY § Build pipeline).
#
# It checks the COMMITS BEING PUSHED, not the working tree. A push sends commits; an
# uncommitted fix in the tree would otherwise pass a push whose commits fail, and an
# uncommitted mess would refuse a push whose commits are clean. EVERY commit, not only each
# ref's tip: a fmt slip in commit 3 of 5, fixed in commit 4, is still a pushed commit that
# fails the step. Per ref that is `git rev-list <remote oid>..<local oid>`; for a new ref
# (or a remote oid this clone does not have) it is every commit not already on a remote,
# `git rev-list <local oid> --not --remotes`, since a commit any remote holds was gated when
# it got there. Deleted refs send nothing and are skipped.
#
# When the commit is HEAD and the tree holds nothing uncommitted (untracked files
# included), the tree IS that commit and is checked in place. Every other commit is checked
# out, in turn, into ONE temporary detached worktree that shares this clone's target
# directory, so dependencies are not rebuilt and successive commits build incrementally.
# A commit older than scripts/pipeline.steps has no contract to read; it is reported as
# UNCHECKED rather than refused, so pushing history to a fresh remote is possible at all.
#
# The commands are READ from scripts/pipeline.steps for this platform, through the same
# parser every runner uses, never written here: a second copy of a step's command is a
# copy that drifts (POLICY § Build pipeline, "A number has one owner" and the contract
# rule). They are read from the pushed commit's own copy, since that is what CI will
# run. Git for Windows runs hooks under its own bash, so one script serves all three
# platforms.
#
# Enable once per clone:   git config core.hooksPath scripts/git-hooks
# Run without pushing:     git push --dry-run
# Prove it refuses:        scripts/git-hooks/pre-push --self-test
# Override for one push:   git push --no-verify
#
# On Windows, push from a shell that carries the GTK build environment
# (packaging/windows/README.md). From a bare shell clippy fails in the -sys crates'
# build scripts with "The pkg-config command could not be found" and the push is
# refused; that is the environment, not the hook.

set -uo pipefail

# --self-test: build a throwaway repo whose contract's fmt step fails when a file named BAD
# is present, push two histories at a throwaway bare remote through THIS hook, and assert
# the verdicts: a BAD commit behind a clean tip is refused (the tip-only defect this hook
# had), and a clean history is accepted (so "refuses everything" cannot pass). It needs no
# cargo; the hook is command-agnostic, so a stand-in command exercises the enumeration.
if [ "${1-}" = "--self-test" ]; then
    hook="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    lib="$(dirname "$hook")/../pipeline-lib.sh"
    [ -f "$lib" ] || { echo "pre-push self-test: no $lib" >&2; exit 1; }
    st="$(mktemp -d "${TMPDIR:-/tmp}/scrib-prepush-selftest.XXXXXX")" || exit 1
    trap 'rm -rf "$st"' EXIT
    (
        set -e
        export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
        git init -q --bare "$st/remote.git"
        git init -q -b main "$st/work"
        cd "$st/work"
        git config user.email selftest@invalid
        git config user.name selftest
        git config core.hooksPath "$(dirname "$hook")"
        mkdir scripts
        cp "$lib" scripts/pipeline-lib.sh
        for p in linux macos windows; do
            printf 'cmd.%s fmt test ! -e BAD\ncmd.%s clippy true\n' "$p" "$p"
        done >scripts/pipeline.steps
        git add -A && git commit -qm base
        git remote add origin "$st/remote.git"
        git push -q origin main >/dev/null 2>&1
        # The negative: a failing commit buried behind a clean tip, on an existing ref.
        touch BAD && git add BAD && git commit -qm "bad"
        git rm -q BAD && git commit -qm "clean tip"
        if git push -q origin main >"$st/neg.log" 2>&1; then
            echo "pre-push self-test: FAILED — a failing commit behind a clean tip was accepted" >&2
            exit 1
        fi
        grep -q "'fmt' failed" "$st/neg.log" || {
            echo "pre-push self-test: FAILED — refused, but not by the fmt step:" >&2
            tail -3 "$st/neg.log" >&2
            exit 1
        }
        # The same on a NEW ref, which takes the --not --remotes path.
        if git push -q origin main:fresh >"$st/new.log" 2>&1; then
            echo "pre-push self-test: FAILED — a new ref carrying a failing commit was accepted" >&2
            exit 1
        fi
        # The positive: rewrite away the bad commit; a clean history must go through.
        git reset -q --hard HEAD~2
        echo ok >GOOD && git add GOOD && git commit -qm "good 1"
        echo ok2 >GOOD && git commit -qam "good 2"
        git push -q origin main >"$st/pos.log" 2>&1 || {
            echo "pre-push self-test: FAILED — a clean history was refused:" >&2
            tail -3 "$st/pos.log" >&2
            exit 1
        }
    ) || exit 1
    echo "pre-push self-test: ok (buried failing commit refused on an existing and a new ref; clean history accepted)"
    exit 0
fi

TOP="$(git rev-parse --show-toplevel)" || exit 1
cd "$TOP" || exit 1

case "$(uname -s)" in
    Linux*) PLATFORM=linux ;;
    Darwin*) PLATFORM=macos ;;
    MINGW* | MSYS* | CYGWIN*) PLATFORM=windows ;;
    *)
        # REFUSE, not pass: a hook that waves a push through unchecked on a platform it does
        # not know is a gate that is silently off. Scribobulate's contract declares only
        # linux/macos/windows (every Git-for-Windows shell reports MINGW/MSYS/CYGWIN), so
        # there is no platform this blocks that it could have checked.
        echo "pre-push: unrecognised platform '$(uname -s)': scripts/pipeline.steps has no" \
            "cmd.<platform> for it, so the push is refused UNCHECKED. Override this one push" \
            "with --no-verify." >&2
        exit 1
        ;;
esac
CONTRACT="scripts/pipeline.steps"
export PLATFORM CONTRACT

# Git feeds one line per pushed ref: <local ref> <local oid> <remote ref> <remote oid>.
# An all-zero local oid is a deletion, which sends no commits to check. Commits are
# gathered oldest first and de-duplicated across refs.
oids=()
while read -r _lref loid _rref roid; do
    [[ "$loid" =~ ^0+$ ]] && continue
    if [[ "$roid" =~ ^0+$ ]] || ! git cat-file -e "$roid^{commit}" 2>/dev/null; then
        range=("$loid" --not --remotes)
    else
        range=("$roid..$loid")
    fi
    list="$(git rev-list --reverse "${range[@]}")" || {
        echo "pre-push: could not list the commits being pushed; refusing to push unchecked." >&2
        exit 1
    }
    for c in $list; do
        [[ " ${oids[*]-} " == *" $c "* ]] && continue
        oids+=("$c")
    done
done
[ "${#oids[@]}" -eq 0 ] && exit 0
echo "pre-push: checking ${#oids[@]} commit(s) being pushed"

# Runs fmt and clippy in the current directory, reading their commands from that tree's
# contract. A subshell, so sourcing the library and exporting nothing leaks between runs.
check_tree() (
    # shellcheck source=scripts/pipeline-lib.sh
    source scripts/pipeline-lib.sh
    for id in fmt clippy; do
        cmd="$(contract_value "cmd.$PLATFORM" "$id")"
        if [ -z "$cmd" ]; then
            echo "pre-push: scripts/pipeline.steps has no cmd.$PLATFORM for '$id';" \
                "refusing to push unchecked." >&2
            exit 1
        fi
        echo "pre-push: $id — $cmd"
        eval "$cmd" || {
            echo "pre-push: '$id' failed, so the push was refused. Fix it, or override" \
                "this one push with --no-verify." >&2
            exit 1
        }
    done
)

HEAD_OID="$(git rev-parse HEAD)"
tmp=""
cleanup() {
    if [ -n "$tmp" ]; then
        git -C "$TOP" worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"
    fi
    git -C "$TOP" worktree prune >/dev/null 2>&1
}
trap cleanup EXIT

for oid in "${oids[@]}"; do
    short="$(git rev-parse --short "$oid")"
    if ! git cat-file -e "$oid:$CONTRACT" 2>/dev/null; then
        echo "pre-push: UNCHECKED $short — it predates $CONTRACT, so it has no steps to run." >&2
        continue
    fi
    if [ "$oid" = "$HEAD_OID" ] && [ -z "$(git status --porcelain)" ]; then
        echo "pre-push: checking $short (HEAD, clean tree) in place"
        check_tree || exit 1
        continue
    fi
    if [ -z "$tmp" ]; then
        tmp="$(mktemp -d "${TMPDIR:-/tmp}/scrib-prepush.XXXXXX")" || exit 1
        git worktree add --detach --quiet "$tmp" "$oid" || {
            echo "pre-push: could not check out $short; refusing to push unchecked." >&2
            exit 1
        }
    else
        git -C "$tmp" checkout --detach --quiet --force "$oid" || {
            echo "pre-push: could not check out $short; refusing to push unchecked." >&2
            exit 1
        }
    fi
    echo "pre-push: checking $short in a temporary worktree ($tmp)"
    (
        cd "$tmp" || exit 1
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
        export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$TOP/target}"
        check_tree
    ) || exit 1
done
